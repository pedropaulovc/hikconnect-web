{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hikconnect-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  // nodejs_compat is required by the OpenNext Cloudflare adapter (Node-compatible
  // server). It also populates process.env from any plain `vars` added below.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
